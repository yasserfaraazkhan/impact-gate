---
const baseUrl = import.meta.env.BASE_URL;
const homeHref = baseUrl;
const quickStartHref = `${baseUrl}getting-started/quick-start/`;
const cliHref = `${baseUrl}reference/cli/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page Not Found | Impact Gate</title>
    <meta
      name="description"
      content="The page you requested could not be found. Start from the Impact Gate docs homepage, quick start, or CLI reference."
    />
    <style>
      :root {
        color-scheme: light dark;
        --bg: #07111f;
        --bg-accent: #10223f;
        --card: rgba(10, 18, 32, 0.78);
        --text: #f3f7fb;
        --muted: #bfd0e6;
        --line: rgba(191, 208, 230, 0.2);
        --primary: #67d7b5;
        --primary-strong: #1f9e7a;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
        font-family:
          "IBM Plex Sans",
          "Segoe UI",
          sans-serif;
        background:
          radial-gradient(circle at top, rgba(103, 215, 181, 0.22), transparent 35%),
          linear-gradient(180deg, var(--bg-accent), var(--bg));
        color: var(--text);
      }

      main {
        width: min(100%, 760px);
        padding: 2.5rem;
        border: 1px solid var(--line);
        border-radius: 28px;
        background: var(--card);
        backdrop-filter: blur(14px);
        box-shadow: 0 32px 80px rgba(0, 0, 0, 0.3);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        border: 1px solid rgba(103, 215, 181, 0.35);
        color: var(--primary);
        font-size: 0.9rem;
        letter-spacing: 0.02em;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.4rem, 5vw, 4rem);
        line-height: 1;
      }

      p {
        margin: 1rem 0 0;
        max-width: 56ch;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.7;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: 2rem;
      }

      a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-width: 180px;
        padding: 0.9rem 1.2rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        transition:
          transform 140ms ease,
          border-color 140ms ease,
          background 140ms ease;
      }

      a:hover {
        transform: translateY(-1px);
      }

      .primary {
        background: linear-gradient(135deg, var(--primary), #8fe6cb);
        color: #052b22;
      }

      .secondary {
        border: 1px solid var(--line);
        color: var(--text);
        background: rgba(255, 255, 255, 0.02);
      }

      .meta {
        margin-top: 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-size: 0.95rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <main>
      <div class="eyebrow">404 • Docs Navigation</div>
      <h1>That page is not in this release.</h1>
      <p>
        Impact Gate’s docs are organized around release readiness, diff-aware
        test planning, and guarded AI workflows. Start from the homepage, jump
        into the quick start, or use the CLI reference to get back on track.
      </p>
      <div class="actions">
        <a class="primary" href={homeHref}>Docs Home</a>
        <a class="secondary" href={quickStartHref}>Quick Start</a>
        <a class="secondary" href={cliHref}>CLI Reference</a>
      </div>
      <div class="meta">
        If you followed an older link, the command or guide may have moved as
        the docs were reorganized for the public launch.
      </div>
    </main>
  </body>
</html>
