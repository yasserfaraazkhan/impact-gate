{
  "name": "e2e-ai-agents",
  "version": "0.2.0",
  "description": "Framework-agnostic LLM provider library for autonomous E2E testing. Integrates with Playwright test agents for AI-powered test discovery, generation, and healing.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "require": "./dist/mcp-server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".mcp.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "echo 'No tests yet'",
    "lint": "echo 'Linting...'",
    "mcp:server": "node dist/mcp-server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.28.0",
    "glob": "^10.0.0",
    "openai": "^4.52.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yasserfaraazkhan/e2e-agents.git"
  },
  "keywords": [
    "llm",
    "testing",
    "anthropic",
    "claude",
    "ollama",
    "autonomous-testing",
    "e2e",
    "playwright",
    "ai",
    "provider",
    "framework-agnostic",
    "mcp",
    "test-agents"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Yasser Khan",
  "homepage": "https://github.com/yasserfaraazkhan/e2e-agents",
  "publishConfig": {
    "access": "public"
  }
}
