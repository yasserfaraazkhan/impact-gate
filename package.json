{
  "name": "e2e-ai-agents",
  "version": "0.2.1",
  "description": "Pluggable LLM provider library for AI-powered test automation. Use Claude, Ollama, or your own LLM. Integrate with Playwright, Jest, or any test framework. MCP server for test agents, cost tracking, and hybrid provider mode.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "require": "./dist/mcp-server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "echo 'No tests yet'",
    "lint": "echo 'Linting...'",
    "mcp:server": "node dist/mcp-server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "glob": "^11.0.0",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yasserfaraazkhan/e2e-agents.git"
  },
  "keywords": [
    "llm",
    "ai",
    "testing",
    "test-automation",
    "e2e",
    "playwright",
    "jest",
    "mocha",
    "cypress",
    "anthropic",
    "claude",
    "ollama",
    "openai",
    "mcp",
    "model-context-protocol",
    "test-agents",
    "ai-testing",
    "autonomous-testing",
    "test-generation",
    "ai-agents",
    "provider-abstraction",
    "framework-agnostic",
    "cost-tracking",
    "hybrid-mode",
    "vision-analysis",
    "screenshot-analysis",
    "test-discovery",
    "test-healing"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Yasser Khan",
  "homepage": "https://github.com/yasserfaraazkhan/e2e-agents",
  "publishConfig": {
    "access": "public"
  }
}
