{
  "name": "@yasserkhanorg/impact-gate",
  "version": "2.2.0",
  "description": "Diff-aware E2E impact analysis, release-ready test planning, coverage gating, and hallucination-resistant AI generation for Playwright/Cypress teams.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/esm/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "require": "./dist/mcp-server.js",
      "import": "./dist/esm/mcp-server.js"
    },
    "./schemas/impact": "./schemas/impact.schema.json",
    "./schemas/gap": "./schemas/gap.schema.json",
    "./schemas/plan": "./schemas/plan.schema.json",
    "./schemas/traceability-input": "./schemas/traceability-input.schema.json",
    "./schemas/subsystem-risk-map": "./schemas/subsystem-risk-map.schema.json",
    "./schemas/route-families": "./schemas/route-families.schema.json",
    "./schemas/flow-decision": "./schemas/flow-decision.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "impact-gate": "./dist/cli.js",
    "e2e-ai-agents": "./dist/cli.js",
    "impact-gate-qa": "./dist/qa-agent/cli.js",
    "e2e-qa-agent": "./dist/qa-agent/cli.js",
    "impact-gate-mcp": "./dist/mcp-server.js",
    "e2e-agents-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "postbuild": "chmod +x dist/cli.js dist/qa-agent/cli.js dist/mcp-server.js",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/write-esm-package.js",
    "clean": "rm -rf dist",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "impact:checklist": "node scripts-dist/impact-checklist.js",
    "impact:local": "node scripts-dist/local-impact-workflow.js",
    "prebuild": "npm run clean",
    "build:test": "tsc -p tsconfig.test.json --noCheck",
    "pretest": "npm run build && npm run build:scripts && npm run build:test",
    "test": "node --test test-dist/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "mcp:server": "node dist/mcp-server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "glob": "^11.0.0",
    "marked": "^15.0.6",
    "minimatch": "^10.2.4",
    "openai": "^4.73.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "agent-browser": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "agent-browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yasserfaraazkhan/impact-gate.git"
  },
  "keywords": [
    "impact-gate",
    "impact-analysis",
    "coverage-gating",
    "ci-gating",
    "llm",
    "ai",
    "testing",
    "test-automation",
    "e2e",
    "playwright",
    "cypress",
    "pytest",
    "supertest",
    "anthropic",
    "claude",
    "ollama",
    "openai",
    "mcp",
    "model-context-protocol",
    "test-agents",
    "ai-testing",
    "autonomous-testing",
    "test-generation",
    "provider-abstraction",
    "cost-tracking",
    "hybrid-mode",
    "test-discovery",
    "test-healing",
    "coverage",
    "qa",
    "ci-cd"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Yasser Khan",
  "homepage": "https://yasserfaraazkhan.github.io/impact-gate/",
  "bugs": {
    "url": "https://github.com/yasserfaraazkhan/impact-gate/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
