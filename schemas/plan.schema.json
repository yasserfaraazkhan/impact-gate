{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattermost.com/schemas/e2e-agents/plan.schema.json",
  "title": "PlanReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "source",
    "runSet",
    "confidence",
    "reasons",
    "recommendedTests",
    "requiredNewTests",
    "policy",
    "decision",
    "enforcement",
    "metrics"
  ],
  "properties": {
    "gapDetails": {"type": "array", "items": {"type": "object", "required": ["id", "name", "priority", "reasons", "files"]}},
    "coveredFlows": {"type": "array", "items": {"type": "object", "required": ["id", "name", "priority", "coveredBy"]}},
    "confidenceKind": {"enum": ["heuristic", "unavailable"]},
    "advisory": {
      "type": "object",
      "required": ["mode", "repository", "baseSha", "requestedBaseSha", "headSha", "changedFiles", "changedFilesSha256", "configurationSha256", "suite", "fileAssessments", "mappings", "inventory", "inventoryStatus", "selectedSpecs", "fullSuiteFallbackReasons", "diffStatus", "executionPolicy", "evidence"],
      "properties": {
        "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "requestedBaseSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "changedFilesSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "configurationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "changedFiles": {"type": "array", "items": {"type": "string"}},
        "inventory": {"type": "array", "items": {"type": "string"}},
        "selectedSpecs": {"type": "array", "items": {"type": "string"}},
        "fullSuiteFallbackReasons": {"type": "array", "items": {"type": "string"}},
        "mode": {"const": "advisory"},
        "repository": {"type": "string"},
        "suite": {"type": "object", "required": ["id", "framework", "root", "configFile", "project", "browser", "variant", "specPattern", "configSha256"]},
        "fileAssessments": {"type": "array", "items": {"type": "object", "required": ["file", "status", "reason"]}},
        "mappings": {"type": "array", "items": {"type": "object", "required": ["file", "suite", "sourcePattern", "specs", "provenance"]}},
        "inventoryStatus": {"const": "static-spec-files"},
        "diffStatus": {"enum": ["empty", "changed"]},
        "executionPolicy": {"const": "retain-full-suite"},
        "evidence": {"type": "object", "required": ["coverage", "execution", "release", "specPresence", "measuredCoverageEdges"], "properties": {"coverage": {"const": "unavailable"}, "execution": {"const": "unavailable"}, "release": {"const": "not-assessed"}, "specPresence": {"enum": ["verified", "unavailable"]}, "measuredCoverageEdges": {"const": 0}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "runId": {
      "type": "string"
    },
    "sourceRunId": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "impact"
    },
    "runSet": {
      "enum": [
        "smoke",
        "targeted",
        "full"
      ]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendedTests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredNewTests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "riskyFiles",
        "triggeredRules",
        "applied"
      ],
      "properties": {
        "riskyFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggeredRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applied": {
          "type": "object",
          "required": [
            "minConfidenceForTargeted",
            "safeMergeMinConfidence",
            "forceFullOnWarningsAtOrAbove",
            "forceFullOnP0WithGaps",
            "forceFullOnRiskyFiles",
            "riskyFilePatterns"
          ],
          "properties": {
            "minConfidenceForTargeted": {
              "type": "number"
            },
            "safeMergeMinConfidence": {
              "type": "number"
            },
            "forceFullOnWarningsAtOrAbove": {
              "type": "number"
            },
            "forceFullOnP0WithGaps": {
              "type": "boolean"
            },
            "forceFullOnRiskyFiles": {
              "type": "boolean"
            },
            "riskyFilePatterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enforcementMode": {
              "enum": ["advisory", "warn", "block"]
            },
            "blockOnActions": {
              "type": "array",
              "items": {
                "enum": ["run-now", "must-add-tests", "safe-to-merge"]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "action",
        "title",
        "summary"
      ],
      "properties": {
        "action": {
          "enum": [
            "run-now",
            "must-add-tests",
            "safe-to-merge"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "enforcement": {
      "type": "object",
      "required": [
        "mode",
        "blockOnActions",
        "matchedAction",
        "shouldFail",
        "summary"
      ],
      "properties": {
        "mode": {
          "enum": ["advisory", "warn", "block"]
        },
        "blockOnActions": {
          "type": "array",
          "items": {
            "enum": ["run-now", "must-add-tests", "safe-to-merge"]
          }
        },
        "matchedAction": {
          "type": "boolean"
        },
        "shouldFail": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "insights": {
      "type": "object",
      "properties": {
        "flaky": {
          "type": "object",
          "required": [
            "highRiskRecommendedTests",
            "quarantinedRecommendedTests"
          ],
          "properties": {
            "highRiskRecommendedTests": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "test",
                  "flakeRate"
                ],
                "properties": {
                  "test": {"type": "string"},
                  "flakeRate": {"type": "number"},
                  "flakeRate7d": {"type": "number"},
                  "flakeRate30d": {"type": "number"},
                  "trend": {"enum": ["up", "down", "stable"]},
                  "subsystem": {"type": "string"},
                  "owners": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "quarantine": {"type": "boolean"},
                  "quarantineState": {"enum": ["none", "active", "retire-candidate"]},
                  "lastFailureAt": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "quarantinedRecommendedTests": {
              "type": "array",
              "items": {"type": "string"}
            },
            "ownerMentions": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "additionalProperties": false
        },
        "qualityGates": {
          "type": "object",
          "required": ["failed", "warnings"],
          "properties": {
            "failed": {
              "type": "array",
              "items": {"$ref": "#/$defs/gate"}
            },
            "warnings": {
              "type": "array",
              "items": {"$ref": "#/$defs/gate"}
            }
          },
          "additionalProperties": false
        },
        "calibration": {
          "type": "object",
          "required": ["precision", "recall", "falseNegativeRate"],
          "properties": {
            "precision": {"type": "number"},
            "recall": {"type": "number"},
            "falseNegativeRate": {"type": "number"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nextActions": {
      "type": "object",
      "required": [
        "requiresUserApprovalForGeneration"
      ],
      "properties": {
        "requiresUserApprovalForGeneration": {"type": "boolean"},
        "runRecommendedTests": {"type": "string"},
        "runSmokeSuite": {"type": "string"},
        "runFullSuite": {"type": "string"},
        "approveAndGenerate": {"type": "string"},
        "generateMissingTests": {"type": "string"},
        "healGeneratedTests": {"type": "string"},
        "commitGeneratedTests": {"type": "string"},
        "openPullRequest": {"type": "string"}
      },
      "additionalProperties": false
    },
    "crew": {
      "type": "object",
      "required": [
        "workflow",
        "providerOverride",
        "summary",
        "impactedFlows",
        "strategyEntries",
        "testDesigns",
        "crossImpacts",
        "regressionRisks",
        "findings",
        "warnings",
        "timings"
      ],
      "properties": {
        "workflow": {"type": "string"},
        "providerOverride": {"type": "string"},
        "summary": {
          "type": "object",
          "required": [
            "impactedFlows",
            "strategyEntries",
            "testDesigns",
            "crossImpacts",
            "highRiskCrossImpacts",
            "regressionRisks",
            "findings",
            "generatedSpecs",
            "manualReviewEntries",
            "totalCostUSD",
            "totalTokens"
          ],
          "properties": {
            "impactedFlows": {"type": "number"},
            "strategyEntries": {"type": "number"},
            "testDesigns": {"type": "number"},
            "crossImpacts": {"type": "number"},
            "highRiskCrossImpacts": {"type": "number"},
            "regressionRisks": {"type": "number"},
            "findings": {"type": "number"},
            "generatedSpecs": {"type": "number"},
            "manualReviewEntries": {"type": "number"},
            "totalCostUSD": {"type": "number"},
            "totalTokens": {"type": "number"}
          },
          "additionalProperties": false
        },
        "impactedFlows": {"type": "array", "items": {"$ref": "#/$defs/flowDecision"}},
        "strategyEntries": {"type": "array", "items": {"$ref": "#/$defs/strategyEntry"}},
        "testDesigns": {"type": "array", "items": {"$ref": "#/$defs/testDesign"}},
        "crossImpacts": {"type": "array", "items": {"$ref": "#/$defs/crossImpact"}},
        "regressionRisks": {"type": "array", "items": {"$ref": "#/$defs/regressionRisk"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "timings": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "changedFiles",
        "impactedFlows",
        "p0Flows",
        "p1Flows",
        "p2Flows",
        "uncoveredP0P1Flows",
        "warnings"
      ],
      "properties": {
        "unboundFiles": {"type": "number"},
        "coveredFlows": {"type": "number"},
        "partialFlows": {"type": "number"},
        "changedFiles": {
          "type": "number"
        },
        "impactedFlows": {
          "type": "number"
        },
        "p0Flows": {
          "type": "number"
        },
        "p1Flows": {
          "type": "number"
        },
        "p2Flows": {
          "type": "number"
        },
        "uncoveredP0P1Flows": {
          "type": "number"
        },
        "warnings": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": {"type": "string"},
        "status": {"enum": ["pass", "warn", "fail"]},
        "details": {"type": "string"}
      },
      "additionalProperties": false
    },
    "flowDecision": {
      "type": "object",
      "required": ["flowId", "flowName", "routeFamily", "changedFiles", "evidence", "evidenceSource", "confidence", "existingSpecs", "action", "priority"],
      "properties": {
        "flowId": {"type": "string"},
        "flowName": {"type": "string"},
        "routeFamily": {"type": "string"},
        "changedFiles": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "string"},
        "evidenceSource": {"enum": ["deterministic", "ai", "hybrid"]},
        "confidence": {"type": "number"},
        "existingSpecs": {"type": "array", "items": {"type": "string"}},
        "action": {"enum": ["create_spec", "update_spec", "skip"]},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "userActions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "strategyEntry": {
      "type": "object",
      "required": ["flowId", "flowName", "priority", "approach", "rationale", "testCategories", "crossImpactRisk"],
      "properties": {
        "flowId": {"type": "string"},
        "flowName": {"type": "string"},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "approach": {"enum": ["full-test", "smoke-test", "skip", "manual-review"]},
        "rationale": {"type": "string"},
        "testCategories": {"type": "array", "items": {"type": "string"}},
        "crossImpactRisk": {"enum": ["high", "medium", "low", "none"]}
      },
      "additionalProperties": false
    },
    "testDesign": {
      "type": "object",
      "required": ["flowId", "flowName", "testCases"],
      "properties": {
        "flowId": {"type": "string"},
        "flowName": {"type": "string"},
        "testCases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "preconditions", "steps", "expectedOutcome", "priority", "rationale"],
            "properties": {
              "name": {"type": "string"},
              "type": {"enum": ["happy-path", "edge-case", "boundary", "negative", "state-transition", "race-condition", "permission", "accessibility", "performance"]},
              "preconditions": {"type": "array", "items": {"type": "string"}},
              "steps": {"type": "array", "items": {"type": "string"}},
              "expectedOutcome": {"type": "string"},
              "priority": {"enum": ["P0", "P1", "P2"]},
              "rationale": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "crossImpact": {
      "type": "object",
      "required": ["sourceFamily", "affectedFamily", "sharedDependency", "riskLevel", "evidence"],
      "properties": {
        "sourceFamily": {"type": "string"},
        "affectedFamily": {"type": "string"},
        "sharedDependency": {"type": "string"},
        "riskLevel": {"enum": ["high", "medium", "low"]},
        "evidence": {"type": "string"}
      },
      "additionalProperties": false
    },
    "regressionRisk": {
      "type": "object",
      "required": ["familyId", "filePattern", "riskScore", "reason", "historicalFailures"],
      "properties": {
        "familyId": {"type": "string"},
        "filePattern": {"type": "string"},
        "riskScore": {"type": "number"},
        "reason": {"type": "string"},
        "historicalFailures": {"type": "number"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "type", "severity", "source", "summary", "details", "relatedFlows"],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["bug", "gap", "risk", "flaky"]},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "source": {"enum": ["strategist", "test-designer", "cross-impact", "regression-advisor", "impact-analyst", "coverage-evaluator", "generator", "executor", "healer", "explorer"]},
        "summary": {"type": "string"},
        "details": {"type": "string"},
        "relatedFlows": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
