{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattermost.com/schemas/e2e-agents/subsystem-risk-map.schema.json",
  "title": "SubsystemRiskMap",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "patterns"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "scoreDelta": {
            "type": "number"
          },
          "priorityFloor": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
